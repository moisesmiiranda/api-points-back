# Copy to .env and fill in. Required for any non-dev run (no SPRING_PROFILES_ACTIVE=dev).
# Never commit the real .env.

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=pointsback
DB_USER=pointsback
DB_PASSWORD=change-me

# JWT signing key: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# First PLATFORM_ADMIN (created on first startup). Password: min 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional
JWT_EXPIRATION_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Public URL of the frontend: the links in emails (reset password, invitations) point to it
APP_BASE_URL=https://app.exemplo.com.br

# --- Email delivery (SMTP works with any provider: SES, Resend, Brevo, Mailgun, ...)
MAIL_HOST=smtp.seuprovedor.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@exemplo.com.br
# Set to false only for a relay that does not use authentication
MAIL_SMTP_AUTH=true

# Optional
PASSWORD_RESET_TTL_MINUTES=60
INVITE_TTL_HOURS=72
PASSWORD_RESET_MAX_REQUESTS=5
